{
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"],
    "AllowCredentials": true,
    "AllowedHeaders": ["*"],
    "AllowedMethods": ["*"]
  },
  "ConnectionStrings": {
    "AuthDb": "Server=localhost;Port=5435;Database=auth_service_db;User Id=postgres;Password=postgres;"
  },
  "OpenIddict": {
    "Issuer": "http://localhost:5277/",
    "Clients": {
      "Web": {
        "ClientId": "gameserver-web",
        "DisplayName": "GameServer Web (dev)",
        "RedirectUris": ["http://localhost:3000/auth/callback"],
        "PostLogoutRedirectUris": ["http://localhost:3000"]
      },
      "Game": {
        "ClientId": "gameserver-unity",
        "DisplayName": "GameServer Unity Client (dev)",
        "RedirectUris": ["http://127.0.0.1:7777/callback", "gameserver://auth/callback"]
      },
      "Service": {
        "ClientId": "auth-service-client",
        "ClientSecret": "dev-only-secret-change-me-0123456789",
        "DisplayName": "AuthService service client (dev)"
      }
    }
  },
  "AuthService": {
    "FrontendLoginUrl": "http://localhost:3000/login"
  }
}
