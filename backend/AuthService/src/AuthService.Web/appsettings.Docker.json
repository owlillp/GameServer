{
  "Cors": {
    "AllowedOrigins": ["https://localhost:5000", "http://localhost:3000"],
    "AllowCredentials": true,
    "AllowedHeaders": ["*"],
    "AllowedMethods": ["*"]
  },
  "OpenIddict": {
    "Issuer": "https://localhost:5001/",
    "Clients": {
      "Web": {
        "ClientId": "gameserver-web",
        "DisplayName": "GameServer Web",
        "RedirectUris": ["https://localhost:5000/auth/callback", "http://localhost:3000/auth/callback"],
        "PostLogoutRedirectUris": ["https://localhost:5000"]
      },
      "Game": {
        "ClientId": "gameserver-unity",
        "DisplayName": "GameServer Unity Client",
        "RedirectUris": ["http://127.0.0.1:7777/callback", "gameserver://auth/callback"]
      },
      "Service": {
        "ClientId": "auth-service-client",
        "ClientSecret": "dev-only-secret-change-me-0123456789",
        "DisplayName": "AuthService service client"
      }
    }
  },
  "AuthService": {
    "FrontendLoginUrl": "https://localhost:5000/login"
  }
}
