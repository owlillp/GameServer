{
  "Cors": {
    "AllowedOrigins": ["https://localhost:5000", "http://localhost:3000"],
    "AllowCredentials": true,
    "AllowedHeaders": ["*"],
    "AllowedMethods": ["*"]
  },
  "ConnectionStrings": {
    "ClanDb": "Server=postgres;Port=5432;Database=auth_service_db;User Id=postgres;Password=postgres;"
  },
  "Authentication": {
    "Authority": "http://auth-service:8080/",
    "Audiences": ["clan-service"]
  },
  "AuthServiceOptions": {
    "Url": "http://auth-service:8080",
    "TimeoutSeconds": 7
  },
  "ServiceToken": {
    "TokenUrl": "http://auth-service:8080/connect/token",
    "ClientId": "auth-service-client",
    "ClientSecret": "dev-only-secret-change-me-0123456789",
    "Scopes": ["auth"]
  }
}
