{
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"],
    "AllowCredentials": true,
    "AllowedHeaders": ["*"],
    "AllowedMethods": ["*"]
  },
  "ConnectionStrings": {
    "ClanDb": "Server=localhost;Port=5435;Database=auth_service_db;User Id=postgres;Password=postgres;"
  },
  "Authentication": {
    "Authority": "http://localhost:5277/",
    "Audiences": ["clan-service"]
  },
  "AuthServiceOptions": {
    "Url": "http://localhost:5277",
    "TimeoutSeconds": 7
  },
  "ServiceToken": {
    "TokenUrl": "http://localhost:5277/connect/token",
    "ClientId": "auth-service-client",
    "ClientSecret": "dev-only-secret-change-me-0123456789",
    "Scopes": ["auth"]
  }
}
